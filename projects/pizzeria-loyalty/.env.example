# Base Neon (Vercel > Storage > Neon l'ajoute automatiquement)
DATABASE_URL=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret de signature des sessions (openssl rand -base64 32)
AUTH_SECRET=change-me

# E-mails qui deviennent administrateurs à l'inscription / connexion (séparés par des virgules)
ADMIN_EMAILS=patron@mapizzeria.fr

# Clés push : npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:patron@mapizzeria.fr

# Protège /api/cron/daily (Vercel l'envoie automatiquement en Bearer)
CRON_SECRET=change-me-too

# Valeurs initiales : tout se modifie ensuite dans Admin → Programme
NEXT_PUBLIC_PIZZERIA_NAME=La Bella Pizza
